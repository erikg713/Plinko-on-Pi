# Copy this file to .env and fill values. DO NOT commit .env to git.
#
# PORT: port the server listens on
PORT=3000

# NODE_ENV: development | production | test
NODE_ENV=development

# DATABASE_URL: PostgreSQL connection string (example)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/plinko_dev

# PI_API_KEY: placeholder only — do NOT commit real keys. Store real keys in a secrets manager.
PI_API_KEY=REPLACE_WITH_YOUR_PI_API_KEY

# Secrets used to sign cookies / tokens. Use long, random values in production.
JWT_SECRET=replace_with_a_strong_random_value
SESSION_SECRET=replace_with_a_strong_random_value

# CORS and security
CORS_ORIGIN=http://localhost:5173

# Logging and monitoring
LOG_LEVEL=info
SENTRY_DSN=

# Rate limiting defaults
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
